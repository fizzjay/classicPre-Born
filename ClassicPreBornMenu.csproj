<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>ClassicPreBornMenu</AssemblyName>
    <RootNamespace>ClassicPreBornMod</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- If UnityEngine.dll is elsewhere, copy it here or adjust HintPath -->
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader 0.5.1 -->
    <Reference Include="MelonLoader">
      <HintPath>MelonLoader.dll</HintPath>
    </Reference>
    <!-- Game assembly (contains Unity refs) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>Assembly-CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
